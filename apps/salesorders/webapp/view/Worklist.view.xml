<mvc:View
	controllerName="com.meridian.salesorders.controller.Worklist"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<!-- Inline styles & hardcoded widths (migration X-09). Deprecated growing patterns (SO-05). -->
	<Page id="worklistPage" title="Sales Orders ({worklistView>/orderCount})">
		<headerContent>
			<Button icon="sap-icon://refresh" tooltip="Refresh" press="onRefresh"/>
		</headerContent>
		<subHeader>
			<Toolbar>
				<SearchField width="20rem" search="onSearch" placeholder="Search order / customer..."/>
				<ToolbarSpacer/>
				<Label text="Sales Org:"/>
				<Select change="onFilterOrg">
					<core:Item key="" text="All"/>
					<core:Item key="1000" text="1000"/>
					<core:Item key="2000" text="2000"/>
					<core:Item key="3000" text="3000"/>
				</Select>
			</Toolbar>
		</subHeader>
		<content>
			<Table
				id="ordersTable"
				items="{/SalesOrderSet}"
				growing="true"
				growingThreshold="20"
				growingScrollToLoad="false"
				mode="SingleSelectMaster"
				itemPress="onSelectOrder">
				<columns>
					<Column><Text text="Order"/></Column>
					<Column><Text text="Customer"/></Column>
					<Column hAlign="Center"><Text text="Status"/></Column>
					<Column><Text text="Created"/></Column>
					<Column hAlign="End"><Text text="Gross Amount"/></Column>
				</columns>
				<items>
					<ColumnListItem type="Navigation" press="onSelectOrder">
						<cells>
							<ObjectIdentifier title="{OrderID}" text="{SalesOrg}"/>
							<Text text="{CustomerName}"/>
							<ObjectStatus
								text="{Status}"
								state="{path: 'Status', formatter: '.formatter.statusState'}"
								icon="{path: 'Status', formatter: '.formatter.statusIcon'}"/>
							<Text text="{path: 'CreatedAt', formatter: '.formatter.shortDate'}"/>
							<ObjectNumber
								number="{path: 'GrossAmount', formatter: '.formatter.amountOnly'}"
								unit="{Currency}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
		</content>
	</Page>
</mvc:View>
