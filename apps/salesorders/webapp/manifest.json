{
	"_version": "1.40.0",
	"sap.app": {
		"id": "com.meridian.salesorders",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"dataSources": {
			"mainService": {
				"uri": "/sap/opu/odata/sap/ZSD_SALESORDER_SRV/",
				"type": "OData",
				"settings": {
					"odataVersion": "2.0",
					"annotations": ["localAnnotations"]
				}
			},
			"localAnnotations": {
				"uri": "annotations.xml",
				"type": "ODataAnnotation",
				"settings": {
					"localUri": "annotations.xml"
				}
			}
		},
		"crossNavigation": {
			"inbounds": {
				"SalesOrder-display": {
					"semanticObject": "SalesOrder",
					"action": "display",
					"signature": {
						"parameters": {},
						"additionalParameters": "allowed"
					}
				}
			}
		}
	},
	"sap.ui": {
		"technicalName": "ZSD_SALESORDER",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		},
		"supportedThemes": ["sap_horizon"]
	},
	"sap.ui5": {
		"dependencies": {
			"minUI5Version": "1.120.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.comp": {},
				"sap.ui.generic.app": {},
				"sap.suite.ui.generic.template": {}
			}
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.meridian.salesorders.i18n.i18n"
				}
			},
			"": {
				"dataSource": "mainService",
				"settings": {
					"defaultBindingMode": "TwoWay",
					"defaultCountMode": "Inline",
					"refreshAfterChange": false
				}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		}
	},
	"sap.ui.generic.app": {
		"_version": "1.3.0",
		"settings": {
			"flexibleColumnLayout": {
				"defaultTwoColumnLayoutType": "TwoColumnsMidExpanded"
			}
		},
		"pages": {
			"ListReport|SalesOrder": {
				"entitySet": "SalesOrderSet",
				"component": {
					"name": "sap.suite.ui.generic.template.ListReport",
					"list": true,
					"settings": {
						"smartVariantManagement": true,
						"condensedTableLayout": true
					}
				},
				"pages": {
					"ObjectPage|SalesOrder": {
						"entitySet": "SalesOrderSet",
						"component": {
							"name": "sap.suite.ui.generic.template.ObjectPage"
						}
					}
				}
			}
		}
	}
}
