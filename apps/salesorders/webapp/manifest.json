{
	"_version": "1.65.0",
	"sap.app": {
		"id": "com.meridian.salesorders",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "0.9.3"
		},
		"dataSources": {
			"salesOrderService": {
				"uri": "/sap/opu/odata/sap/ZSD_SALESORDER_SRV/",
				"type": "OData",
				"settings": {
					"odataVersion": "2.0"
				}
			}
		}
	},
	"sap.ui": {
		"technicalName": "ZSD_SALESORDER",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		},
		"supportedThemes": ["sap_horizon"]
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "com.meridian.salesorders.view.App",
			"type": "XML",
			"id": "appRoot"
		},
		"dependencies": {
			"minUI5Version": "1.120.0",
			"libs": {
				"sap.m": {},
				"sap.ui.layout": {},
				"sap.ui.core": {}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"models": {
			"": {
				"dataSource": "salesOrderService",
				"settings": {
					"defaultBindingMode": "TwoWay",
					"useBatch": false,
					"sizeLimit": 500
				}
			},
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.meridian.salesorders.i18n.i18n"
				}
			}
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"viewType": "XML",
				"viewPath": "com.meridian.salesorders.view",
				"controlId": "app",
				"controlAggregation": "pages",
				"transition": "slide",
				"async": true
			},
			"routes": [
				{
					"pattern": "",
					"name": "worklist",
					"target": "worklist"
				},
				{
					"pattern": "order/{orderId}",
					"name": "object",
					"target": "object"
				}
			],
			"targets": {
				"worklist": {
					"viewName": "Worklist",
					"viewLevel": 1
				},
				"object": {
					"viewName": "Object",
					"viewLevel": 2
				}
			}
		}
	}
}
