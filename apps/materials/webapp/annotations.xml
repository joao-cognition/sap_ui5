<?xml version="1.0" encoding="utf-8"?>
<!-- Local UI annotations for the Material Master Fiori elements app (display-centric List Report).
     Targets the consolidated OData V2 mock service ZMM_MATERIAL_SRV (MERIDIAN namespace). -->
<edmx:Edmx Version="1.0"
		xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx"
		xmlns:edm="http://docs.oasis-open.org/odata/ns/edm">
	<edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
		<edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
	</edmx:Reference>
	<edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
		<edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
	</edmx:Reference>
	<edmx:DataServices>
		<Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="MERIDIAN.UI">

			<Annotations xmlns="http://docs.oasis-open.org/odata/ns/edm" Target="MERIDIAN.Material/MaterialID">
				<Annotation Term="Common.Label" String="Material"/>
			</Annotations>
			<Annotations xmlns="http://docs.oasis-open.org/odata/ns/edm" Target="MERIDIAN.Material/Description">
				<Annotation Term="Common.Label" String="Description"/>
			</Annotations>
			<Annotations xmlns="http://docs.oasis-open.org/odata/ns/edm" Target="MERIDIAN.Material/MaterialType">
				<Annotation Term="Common.Label" String="Type"/>
			</Annotations>
			<Annotations xmlns="http://docs.oasis-open.org/odata/ns/edm" Target="MERIDIAN.Material/BaseUnit">
				<Annotation Term="Common.Label" String="Base Unit"/>
			</Annotations>
			<Annotations xmlns="http://docs.oasis-open.org/odata/ns/edm" Target="MERIDIAN.Material/Plant">
				<Annotation Term="Common.Label" String="Plant"/>
			</Annotations>
			<Annotations xmlns="http://docs.oasis-open.org/odata/ns/edm" Target="MERIDIAN.Material/StockQuantity">
				<Annotation Term="Common.Label" String="Stock Quantity"/>
			</Annotations>
			<Annotations xmlns="http://docs.oasis-open.org/odata/ns/edm" Target="MERIDIAN.Material/StandardPrice">
				<Annotation Term="Common.Label" String="Standard Price"/>
			</Annotations>

			<Annotations xmlns="http://docs.oasis-open.org/odata/ns/edm" Target="MERIDIAN.Material">

				<Annotation Term="UI.HeaderInfo">
					<Record Type="UI.HeaderInfoType">
						<PropertyValue Property="TypeName" String="Material"/>
						<PropertyValue Property="TypeNamePlural" String="Materials"/>
						<PropertyValue Property="Title">
							<Record Type="UI.DataField">
								<PropertyValue Property="Value" Path="Description"/>
							</Record>
						</PropertyValue>
						<PropertyValue Property="Description">
							<Record Type="UI.DataField">
								<PropertyValue Property="Value" Path="MaterialID"/>
							</Record>
						</PropertyValue>
					</Record>
				</Annotation>

				<Annotation Term="UI.SelectionFields">
					<Collection>
						<PropertyPath>MaterialType</PropertyPath>
						<PropertyPath>Plant</PropertyPath>
					</Collection>
				</Annotation>

				<Annotation Term="UI.LineItem">
					<Collection>
						<Record Type="UI.DataField">
							<PropertyValue Property="Value" Path="MaterialID"/>
						</Record>
						<Record Type="UI.DataField">
							<PropertyValue Property="Value" Path="Description"/>
						</Record>
						<Record Type="UI.DataField">
							<PropertyValue Property="Value" Path="MaterialType"/>
						</Record>
						<Record Type="UI.DataField">
							<PropertyValue Property="Value" Path="BaseUnit"/>
						</Record>
						<Record Type="UI.DataField">
							<PropertyValue Property="Value" Path="Plant"/>
						</Record>
						<Record Type="UI.DataField">
							<PropertyValue Property="Value" Path="StockQuantity"/>
						</Record>
						<Record Type="UI.DataField">
							<PropertyValue Property="Value" Path="StandardPrice"/>
						</Record>
						<Record Type="UI.DataField">
							<PropertyValue Property="Value" Path="Currency"/>
						</Record>
					</Collection>
				</Annotation>

				<Annotation Term="UI.FieldGroup" Qualifier="GeneralInfo">
					<Record Type="UI.FieldGroupType">
						<PropertyValue Property="Data">
							<Collection>
								<Record Type="UI.DataField">
									<PropertyValue Property="Value" Path="MaterialType"/>
								</Record>
								<Record Type="UI.DataField">
									<PropertyValue Property="Value" Path="BaseUnit"/>
								</Record>
								<Record Type="UI.DataField">
									<PropertyValue Property="Value" Path="Plant"/>
								</Record>
								<Record Type="UI.DataField">
									<PropertyValue Property="Value" Path="StockQuantity"/>
								</Record>
								<Record Type="UI.DataField">
									<PropertyValue Property="Value" Path="StandardPrice"/>
								</Record>
								<Record Type="UI.DataField">
									<PropertyValue Property="Value" Path="Currency"/>
								</Record>
							</Collection>
						</PropertyValue>
					</Record>
				</Annotation>

				<Annotation Term="UI.Facets">
					<Collection>
						<Record Type="UI.ReferenceFacet">
							<PropertyValue Property="Label" String="General Information"/>
							<PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#GeneralInfo"/>
						</Record>
					</Collection>
				</Annotation>

			</Annotations>

		</Schema>
	</edmx:DataServices>
</edmx:Edmx>
